# Used when `eve-agent model gateway` is selected.
AI_GATEWAY_API_KEY=

# Optional non-interactive Ollama Cloud credential. `eve-agent login ollama-cloud`
# stores the key in ~/.config/eve-agent/auth.json instead.
# OLLAMA_API_KEY=

# Normally set by the eve-agent launcher; uncomment only when running `npm run dev`.
# CODING_WORKSPACE=/absolute/path/to/a/repository
